# ─────────────────────────────────────────────────────────────
# LUTSA-CORE · plantilla de variables de entorno
#
# Copia según el ambiente:
#   private/.env.sandbox      -> desarrollo
#   private/.env.production   -> producción
# Se elige con la variable de sistema APP_ENV (por defecto: sandbox).
# Los archivos reales están en .gitignore: NUNCA se versionan.
# ─────────────────────────────────────────────────────────────

APP_NAME=LUTSA-CORE
APP_ENV=sandbox
APP_VERSION=0.1.0
API_PORT=8090
DOCS_ENABLED=true

# MongoDB (docker compose lo publica en el puerto 27037). Una base por ambiente.
MONGODB_URI=mongodb://localhost:27037
MONGODB_DB=lutsa_sandbox
MONGODB_TIMEOUT_MS=3000
MONGODB_LOGS_DB=lutsa_logs_sandbox
LOG_RETENTION_DAYS=30
LOG_MIN_LEVEL=INFO

# Orígenes de la landing que pueden llamar al API (coma). Vite dev: 5173 · preview: 4173.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Solicitudes de cotización ────────────────────────────────────────────────
# Quién recibe cada solicitud por correo (coma).
QUOTE_NOTIFICATION_EMAILS=ventas@lutsa.mx
# Límite anti-abuso por IP: N solicitudes por ventana de segundos.
QUOTE_RATE_LIMIT=5
QUOTE_RATE_WINDOW_SECONDS=600

# Llave para los endpoints internos (cabecera X-API-Key). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=<genera-un-secreto-de-64-caracteres>

# ── "No soy un robot" (Google reCAPTCHA v2, casilla) ─────────────────────────
# En sandbox puedes usar la clave de PRUEBA pública de Google (siempre aprueba):
#   6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojQ4WifJWe
# En producción crea las claves en https://www.google.com/recaptcha/admin (tipo v2 casilla)
# y pon la "clave del sitio" en la landing (VITE_RECAPTCHA_SITE_KEY).
CAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=<clave-secreta-de-recaptcha>

# ── Correo saliente (SMTP) ───────────────────────────────────────────────────
# Sin SMTP_HOST los correos solo se escriben en el log del API.
# Gmail: smtp.gmail.com:587 con una "contraseña de aplicación" (requiere verificación en 2 pasos):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=<tu-cuenta@gmail.com>
SMTP_PASSWORD=<contraseña-de-aplicación>
SMTP_FROM=LUTSA Landing <tu-cuenta@gmail.com>
