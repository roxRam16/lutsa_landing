# Copia este archivo como .env.ftp y llena tus datos. .env.ftp NO se sube a git;
# este .example SÍ se sube, así que aquí nunca van datos reales.
# Recomendado: crea en tu hosting un usuario SOLO para la carpeta de pruebas.

# Protocolo: sftp (SSH, el más común en IONOS/1&1) · ftps (FTP cifrado) · ftp (sin cifrar)
FTP_PROTOCOL=sftp
FTP_HOST=tu-servidor.ejemplo.com
# 22 para sftp · 21 para ftp/ftps
FTP_PORT=22
FTP_USER=usuario
FTP_PASSWORD=la_contraseña
# Carpeta del servidor donde vive la versión de pruebas (lutsa.mx/prueba/). Nunca la raíz.
FTP_REMOTE_DIR=/prueba
# Si tu usuario solo ve su carpeta (su "/" ya es la de pruebas): FTP_REMOTE_DIR=/ y descomenta la siguiente línea
# FTP_ALLOW_ROOT=true
# Solo ftps: false si tu hosting usa un certificado propio/autofirmado
# FTP_VERIFY_CERT=true
